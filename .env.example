# ─── Django ───────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-secure-secret-key-here

# Set to False in production
DEBUG=False

# Comma-separated exact hostnames. In Django, do NOT use '*.up.railway.app' wildcard syntax.
# Use your exact Railway generated hostname and your custom domains:
# Example: creamy-delights-production.up.railway.app,creamydelights.in,www.creamydelights.in
ALLOWED_HOSTS=

# Comma-separated HTTPS origins for Django admin CSRF (must include full scheme https://).
# Example: https://creamy-delights-production.up.railway.app,https://creamydelights.in,https://www.creamydelights.in
CSRF_TRUSTED_ORIGINS=

# ─── Database ─────────────────────────────────────────────────────────────────
# Railway PostgreSQL provides this automatically.
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=

# ─── Media (Railway Volume) ───────────────────────────────────────────────────
# Railway Volume must be mounted at /data in Railway dashboard.
# Set this in Railway environment variables:
MEDIA_ROOT=/data/media

# ─── CORS (local dev only) ────────────────────────────────────────────────────
# Only needed for local development when Astro runs on :4321
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
