---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  centered?: boolean;
}

const { eyebrow, title, description, centered = false } = Astro.props;
---

<div class={`section-heading ${centered ? 'text-center' : ''}`} style={centered ? 'text-align: center; margin: 0 auto 48px; max-width: 720px;' : 'margin-bottom: 40px;'}>
  <p class="eyebrow">{eyebrow}</p>
  <h2>{title}</h2>
  {description && <p style="font-size: 17px; margin-top: 14px; max-width: 640px;">{description}</p>}
</div>
